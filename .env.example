# ==============================================================================
# MEDIRAG-XAI Environment Variables Template
# ==============================================================================
# Copy this file to backend/.env and replace placeholder values with your actual keys.
# NEVER commit your actual .env file with real secrets to version control.
# ==============================================================================

# --- LLM Provider Selection ---
# Options: 'groq', 'gemini', 'xai', or 'none' (fallback mode)
LLM_PROVIDER=groq

# --- Groq Configuration (Recommended for high-speed free inference) ---
# Get free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# --- Google Gemini Configuration ---
# Get free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- xAI Grok Configuration (Optional) ---
# Get API key at: https://console.x.ai
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-2

# --- Database Configuration ---
# Local MongoDB: mongodb://localhost:27017
# MongoDB Atlas Cloud: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# --- Server & CORS Configuration ---
PORT=8000
HOST=0.0.0.0
RELOAD=false

# Allowed CORS Origins (comma-separated). Set to * for all, or specify frontend domain(s)
# Example: CORS_ORIGINS=https://your-medirag-frontend.vercel.app,http://localhost:5500
CORS_ORIGINS=*
